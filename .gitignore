# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw 2x screen captures — crop/downscale before they go in public/
tools/shots/

# Overlay captures ship as WebP (cwebp -q 90 -m 6). The lossless PNG sources
# beside them are 2.9 MB working files: keep them out.
public/shots/paguro-overlay/*.png

# Maintainer notes: the long-form README the public one replaced, and the
# working notes under content/ (captures, privacy policy). Kept out of the
# repo on purpose, since the repo is public.
/NOTES.md
/content/
